# Public canonical URL. Set this after connecting a custom domain.
NEXT_PUBLIC_ROOT_URL=https://your-domain.example

# Cloudflare R2 (gallery images and future admin image uploads)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=varun-images
R2_PUBLIC_URL=https://your-public-bucket-url

# VoyageAI API Key for generating embeddings
# Get yours at: https://www.voyageai.com/
VOYAGE_AI_API_KEY=your_voyage_ai_api_key_here

# Neon PostgreSQL Database URL (main database for blog content chunks)
# Format: postgresql://user:password@host/database?sslmode=require
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require

# Anthropic API Key for LLM operations (cluster labeling, etc.)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Spotify API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Admin panel password (required to access /admin and /api/admin/*)
ADMIN_SECRET=
